{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Cognivault Backend",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Cognivault UI",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"UI/app.py",
				"--server.address",
				"127.0.0.1",
				"--server.port",
				"8501"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}